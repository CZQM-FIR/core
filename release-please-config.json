{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "separate-pull-requests": true,
  "always-link-local": true,
  "plugins": [
    {
      "type": "node-workspace",
      "merge": true
    }
  ],
  "packages": {
    "apps/web": {
      "release-type": "node",
      "package-name": "web",
      "component": "web"
    },
    "apps/overseer": {
      "release-type": "node",
      "package-name": "overseer",
      "component": "overseer"
    },
    "apps/vector": {
      "release-type": "node",
      "package-name": "vector",
      "component": "vector"
    },
    "apps/worker": {
      "release-type": "node",
      "package-name": "worker",
      "component": "worker"
    },
    "packages/common": {
      "release-type": "node",
      "package-name": "common",
      "component": "common"
    },
    "packages/db": {
      "release-type": "node",
      "package-name": "db",
      "component": "db"
    }
  }
}
